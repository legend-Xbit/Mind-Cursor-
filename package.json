{
  "name": "mind-cursor",
  "version": "0.1.0",
  "description": "MCP work layer that wires Cursor SDK agents to Notion, Vercel, and other tools",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "mind-cursor": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "mind": "node --import tsx src/cli.ts",
    "serve": "node --import tsx src/cli.ts serve",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.check.json",
    "validate:commands": "node --import tsx scripts/validate-commands.ts"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.0",
    "@modelcontextprotocol/sdk": "~1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
