# Cursor SDK — required to launch agents
CURSOR_API_KEY=

# Optional defaults
MIND_CURSOR_CONFIG=./mind-cursor.config.json
MIND_CURSOR_MODEL=composer-2.5
MIND_CURSOR_RUNTIME=local

# Notion — https://mcp.notion.com/mcp (OAuth in the Cursor app, or a token here)
NOTION_API_KEY=
NOTION_MCP_URL=https://mcp.notion.com/mcp

# Vercel — https://mcp.vercel.com
VERCEL_TOKEN=
VERCEL_MCP_URL=https://mcp.vercel.com

# GitHub
GITHUB_TOKEN=
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/

# Slack — https://mcp.slack.com/mcp
SLACK_BOT_TOKEN=
SLACK_MCP_URL=https://mcp.slack.com/mcp

# Linear
LINEAR_API_KEY=
LINEAR_MCP_URL=https://mcp.linear.app/mcp

# Figma OAuth (SDK cannot open a browser; reuse a Cursor-app login or pass a token)
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
FIGMA_MCP_URL=https://mcp.figma.com/mcp

# Treg / Plain — no public default URL; set yours
TREG_API_KEY=
TREG_MCP_URL=
PLAIN_API_KEY=
PLAIN_MCP_URL=

# Cloud runtime
MIND_CURSOR_REPO_URL=
MIND_CURSOR_STARTING_REF=main
